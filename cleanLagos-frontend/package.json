{
  "name": "cleanlagos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "cd apps/mobile && pnpm start",
    "dev:admin": "cd apps/admin-dashboard && pnpm dev",
    "build:admin": "cd apps/admin-dashboard && pnpm build",
    "build:analyze": "cd apps/admin-dashboard && pnpm build && open dist/stats.html",
    "install:all": "pnpm install",
    "clean": "pnpm store prune && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:cache": "pnpm store prune"
  },
  "devDependencies": {
    "cosmiconfig": "^6.0.0"
  },
  "overrides": {
    "cosmiconfig": "^6.0.0"
  },
  "description": "CleanLagos Waste Management System",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cleanlagos-frontend.git"
  },
  "author": "CleanLagos Team",
  "license": "MIT",
  "dependencies": {
    "async-limiter": "^2.0.0"
  }
}
